{
  "name": "fairround",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @fairround/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @fairround/web typecheck",
    "test": "tsx --test packages/shared/*.test.ts",
    "test:e2e": "playwright test",
    "test:judge": "tsx scripts/test-judge.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:reset": "tsx prisma/seed.ts --reset"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@axe-core/playwright": "^4.11.1",
    "@types/node": "^22.19.15",
    "@types/dockerode": "^3.3.47",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/express": "^5.0.6",
    "@types/cookie-parser": "^1.4.10",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4"
  }
}
