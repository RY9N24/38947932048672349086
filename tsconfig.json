{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/judge/**/*.ts",
    "packages/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ]
}
